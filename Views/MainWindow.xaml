<Window x:Class="SAV.MainWindow"
        Icon="/Assets/sav_icon.png"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAV"
        mc:Ignorable="d"
        Title="Sistema de Alterações de Vias" 
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="ApplicationCommands.Undo" />
    </Window.InputBindings>

    <Grid Background="{DynamicResource corDestaquePrimaria}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="2" />
            <RowDefinition/>
            <RowDefinition Height="2" />
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Background="{DynamicResource corTemaPrimaria}" Panel.ZIndex="3"/>

        <Grid Grid.Row="3" Background="{DynamicResource corTemaPrimaria}" Panel.ZIndex="3"/>

        <!-- Menu superior -->
        <Grid Grid.Row="0" Background="{DynamicResource corDestaquePrimaria}" Panel.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Image Source="/Assets/sav_logo.png"/>
            </Grid>
            <Grid Grid.Column="1">
                <Rectangle Fill="{DynamicResource corTemaPrimaria}" Width="4" Height="50" />
            </Grid>
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Projeto" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Style="{DynamicResource efeitoOpcoes}" Cursor="Hand"
                           MouseDown="AbrirMenuProjeto_MouseDown">
                    <TextBlock.ContextMenu>
                        <ContextMenu x:Name="MenuProjeto">
                            <MenuItem Header="Novo" Tag="NovoProjeto" Click="OpcaoProjeto_Click" />
                            <MenuItem Header="Abrir" Tag="AbrirProjeto" Click="OpcaoProjeto_Click" />
                            <Separator/>
                            <MenuItem Header="Salvar" Tag="SalvarProjeto" Click="OpcaoProjeto_Click" />
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>

                <TextBlock MouseDown="AbrirConfiguracoes_MouseDown" x:Name="abrirConfiguracoes" Grid.Column="1" Text="Configurações" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Style="{DynamicResource efeitoOpcoes}"/>

                <TextBlock Grid.Column="2" Text="Ajuda" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Style="{DynamicResource efeitoOpcoes}" Cursor="Hand"/>
            </Grid>
        </Grid>

        <!-- Conteúdo principal - mapa e menus laterais -->
        <Grid Grid.Row="2" Cursor="">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Panel.ZIndex="1" Background="{DynamicResource corDestaqueTerciaria}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="70" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!-- Editar -->
                <Grid Grid.Row="0">
                    <RadioButton x:Name="botaoEditar" 
                                 GroupName="Ferramentas"
                                 IsChecked="True"
                                 Cursor="Hand"
                                 Checked="Ferramenta_Checked">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Grid Style="{DynamicResource fundoGridFerramentas}" Margin="0, 0, -10, 0">
                                    <Viewbox Width="30" Height="30">
                                        <Path Style="{DynamicResource efeitoEditar}"
                                              Data="M3.3572 3.23397C3.66645 2.97447 4.1014 
                                              2.92638 4.45988 3.11204L20.7851 11.567C21.1426 
                                              11.7522 21.3542 12.1337 21.322 12.5351C21.2898 
                                              12.9364 21.02 13.2793 20.6375 13.405L13.7827 
                                              15.6586L10.373 22.0179C10.1828 22.3728 9.79826 
                                              22.5789 9.39743 22.541C8.9966 22.503 8.65762 22.2284 
                                              8.53735 21.8441L3.04564 4.29872C2.92505 3.91345 3.04794 
                                              3.49346 3.3572 3.23397ZM5.67123 5.99173L9.73507 
                                              18.9752L12.2091 14.361C12.3304 14.1347 12.5341 13.9637 
                                              12.7781 13.8835L17.7518 12.2484L5.67123 5.99173Z"
                                              Stretch="Uniform">
                                        </Path>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </Grid>

                <!-- Adicionar/criar -->
                <Grid Grid.Row="1">
                    <RadioButton x:Name="botaoAdicionar" 
                                 GroupName="Ferramentas" 
                                 Cursor="Hand"
                                 Checked="Ferramenta_Checked">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Grid Style="{DynamicResource fundoGridFerramentas}" Margin="0, 0, -10, 0">
                                    <Viewbox Width="30" Height="30">
                                        <Path Style="{DynamicResource efeitoAdicionar}"
                                              Data="M4 12H20M12 4V20"
                                              StrokeThickness="2" 
                                              Stretch="Uniform">
                                        </Path>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </Grid>

                <!-- Deletar -->
                <Grid Grid.Row="2">
                    <RadioButton x:Name="botaoDeletar" 
                                 GroupName="Ferramentas" 
                                 Cursor="Hand"
                                 Checked="Ferramenta_Checked">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Grid Style="{DynamicResource fundoGridFerramentas}" Margin="0, 0, -10, 0">
                                    <Viewbox Width="30" Height="30" Cursor="">
                                        <Path Style="{DynamicResource efeitoDeletar}"
                                              Data="M5.29289 5.29289C5.68342 4.90237 
                                              6.31658 4.90237 6.70711 5.29289L12 
                                              10.5858L17.2929 5.29289C17.6834 4.90237 
                                              18.3166 4.90237 18.7071 5.29289C19.0976 
                                              5.68342 19.0976 6.31658 18.7071
                                              6.70711L13.4142 12L18.7071 17.2929C19.0976
                                              17.6834 19.0976 18.3166 18.7071 18.7071C18.3166
                                              19.0976 17.6834 19.0976 17.2929 18.7071L12
                                              13.4142L6.70711 18.7071C6.31658 19.0976 5.68342
                                              19.0976 5.29289 18.7071C4.90237 18.3166 4.90237
                                              17.6834 5.29289 17.2929L10.5858 12L5.29289
                                              6.70711C4.90237 6.31658 4.90237 5.68342
                                              5.29289 5.29289Z" 
                                              Stretch="Uniform" Cursor="Hand">
                                        </Path>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </Grid>
                
                <!-- Eventos -->
                <Grid Grid.Row="3">
                    <RadioButton x:Name="botaoEventos" 
                     GroupName="Ferramentas" 
                     Cursor="Hand"
                     Checked="Ferramenta_Checked">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Grid Style="{DynamicResource fundoGridFerramentas}" Margin="0, 0, -10, 0">
                                    <Viewbox Width="30" Height="30">
                                        <Path Style="{DynamicResource efeitoEditar}"
                                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" 
                                  Stretch="Uniform">
                                        </Path>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </Grid>
            </Grid>

            <Grid Grid.Column="1" 
                  Background="{DynamicResource corDestaquePrimaria}" 
                  ClipToBounds="True"
                  MouseDown="ManusearMapa_Click" 
                  MouseMove="ManusearMapa_Move" 
                  MouseUp="ManusearMapa_MouseUp"
                  MouseWheel="ManusearMapa_Zoom">

                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Panel.ZIndex="1" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Button x:Name="btnExcluir" 
                                Content="Excluir Vias" 
                                Visibility="Collapsed" 
                                Click="ExecutarExclusao_Click" 
                                Background="{DynamicResource vermelhoSemantico}" 
                                Foreground="{DynamicResource corDestaquePrimaria}" 
                                FontWeight="Bold"/>
                        </Grid>

                        <Grid Grid.Column="1">
                            <TextBlock x:Name="TxtNivelZoom" 
                                   Text="Zoom: 100%" 
                                   Foreground="{DynamicResource corFonte}" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   FontWeight="Bold"
                                   Margin="5,0,5,0"/>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Button Content="Recentralizar Mapa" 
                                Background="{DynamicResource corTemaPrimaria}" 
                                Foreground="{DynamicResource corDestaquePrimaria}" 
                                Cursor="Hand"
                                FontWeight="Bold"
                                Click="BotaoCentralizar_Click"/>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1">
                    <Canvas x:Name="CanvasMapa" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="TransformarZoom" ScaleX="1.0" ScaleY="1.0" />
                                <TranslateTransform x:Name="TransformarArrasto" X="0" Y="0"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                </Grid>
            </Grid>

            <Grid Grid.Column="2" Panel.ZIndex="1" Background="{DynamicResource corDestaqueTerciaria}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ToggleButton Grid.Column="0"
                              x:Name="BtnRetratil"
                              Cursor="Hand"
                              Content="◀"
                              FontSize="16"
                              Width="25"
                              Height="300"
                              VerticalAlignment="Center"
                              Checked="BtnRetratil_Checked"
                              Unchecked="BtnRetratil_Unchecked"
                              Background="{DynamicResource corTemaPrimaria}"
                              Foreground="{DynamicResource corFonte}"
                              BorderThickness="0">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}"
                                    x:Name="BordaBotaoRetratil"
                                    CornerRadius="0, 15, 15, 0" 
                                    BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="BordaBotaoRetratil" Property="CornerRadius" Value="15, 0, 0, 15"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Grid Grid.Column="1" x:Name="ContainerMenuDireito" Width="0" Background="{DynamicResource corDestaqueTerciaria}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource corTemaPrimaria}" Padding="10">
                        <TextBlock Text="Propriedades" Foreground="{DynamicResource corDestaquePrimaria}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="12"/>
                    </Border>

                    <TextBlock x:Name="TxtAvisoSemSelecao" 
                               Grid.Row="1" 
                               Text="Nenhuma via selecionada" 
                               Foreground="{DynamicResource corFonte}" 
                               FontSize="14" 
                               FontStyle="Italic"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               TextAlignment="Center"
                               Margin="20"
                               Visibility="Visible"/>

                    <ScrollViewer x:Name="ScrollPainelLateral" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12" Visibility="Collapsed">
                        <Grid>
                            <StackPanel x:Name="PainelDadosRua" Visibility="Visible">

                                <StackPanel.Resources>
                                    <Style x:Key="EstiloCardVelocidade" TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="#FFFFFF" />
                                        <Setter Property="Foreground" Value="#000000"/>
                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                        <Setter Property="BorderThickness" Value="8"/>
                                        <Setter Property="Padding" Value="5, 15" />
                                        <Setter Property="FontSize" Value="18" />
                                        <Setter Property="FontWeight" Value="bold" />
                                        <Setter Property="Margin" Value="2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                                            CornerRadius="50" 
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#000000" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#000000" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>

                                    <Style x:Key="EstiloCardDirecao" TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="{DynamicResource corDestaquePrimaria}" />
                                        <Setter Property="Foreground" Value="{DynamicResource corFonte}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource corDestaqueTerciaria}"/>
                                        <Setter Property="BorderThickness" Value="4"/>
                                        <Setter Property="Padding" Value="5, 15" />
                                        <Setter Property="FontSize" Value="18" />
                                        <Setter Property="FontWeight" Value="bold" />
                                        <Setter Property="Margin" Value="2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                                            CornerRadius="12" 
                                                            Padding="2, 30">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource amareloSemantico}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource amareloSemantico}" />
                                                <Setter Property="Background" Value="#000000" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Resources>

                                <TextBlock Text="Nome da Via:" Foreground="{DynamicResource corFonte}" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtNomeRua" 
                                         Background="#22FFFFFF" 
                                         Foreground="{DynamicResource corFonte}" 
                                         BorderBrush="{DynamicResource corTemaSecundaria}" 
                                         Padding="5" 
                                         Margin="0,0,0,15" 
                                         FontSize="13" 
                                         FontWeight="Bold"/>

                                <TextBlock Text="Velocidade Máxima (km/h):" Foreground="{DynamicResource corFonte}" FontSize="11" Margin="0,0,0,5"/>
                                <ListBox x:Name="LstVelocidadeRua" 
                                         Background="Transparent" 
                                         BorderThickness="0" 
                                         Margin="0,0,0,15"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBoxItem Content="Sem info" Tag="" Style="{StaticResource EstiloCardVelocidade}" FontSize="9"/>
                                    <ListBoxItem Content="30" Tag="30" Style="{StaticResource EstiloCardVelocidade}"/>
                                    <ListBoxItem Content="40" Tag="40" Style="{StaticResource EstiloCardVelocidade}"/>
                                    <ListBoxItem Content="50" Tag="50" Style="{StaticResource EstiloCardVelocidade}"/>
                                    <ListBoxItem Content="60" Tag="60" Style="{StaticResource EstiloCardVelocidade}"/>
                                    <ListBoxItem Content="80" Tag="80" Style="{StaticResource EstiloCardVelocidade}"/>
                                    <ListBoxItem Content="90" Tag="90" Style="{StaticResource EstiloCardVelocidade}"/>
                                    <ListBoxItem Content="110" Tag="110" Style="{StaticResource EstiloCardVelocidade}"/>
                                    <ListBoxItem Content="120" Tag="120" Style="{StaticResource EstiloCardVelocidade}"/>
                                </ListBox>

                                <TextBlock Text="Direção do Fluxo:" Foreground="{DynamicResource corFonte}" FontSize="11" Margin="0,0,0,5"/>
                                <ListBox x:Name="LstDirecaoRua" 
                                         Background="Transparent" 
                                         BorderThickness="0" 
                                         Margin="0,0,0,15">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBoxItem Content="Dupla" Tag="no" Style="{StaticResource EstiloCardDirecao}"/>
                                    <ListBoxItem Content="Única" Tag="yes" Style="{StaticResource EstiloCardDirecao}"/>
                                </ListBox>
                            </StackPanel>

                            <StackPanel x:Name="PainelEventos" Visibility="Collapsed">
                                <TextBlock Text="Simulador de Cenários" FontWeight="Bold" Foreground="{DynamicResource corFonte}" FontSize="14" Margin="0,5,0,15"/>

                                <TextBlock Text="Selecione o Tipo de Evento Virtual:" Foreground="{DynamicResource corFonte}" FontSize="11" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CboTipoEvento" Height="32" Margin="0,0,0,20" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Obras na Via (Bloqueio Total)" IsSelected="True"/>
                                    <ComboBoxItem Content="Acidente de Trânsito"/>
                                    <ComboBoxItem Content="Grande Evento (Concerto/Futebol)"/>
                                    <ComboBoxItem Content="Inundação / Chuva Forte"/>
                                </ComboBox>

                                <Border Background="#15FFFFFF" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Previsão de Impactos Urbanos" FontWeight="Bold" Foreground="{DynamicResource corFonte}" FontSize="12" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="TxtRelatorioImpacto" 
                               Text="Clique em qualquer rua do mapa para iniciar a simulação e gerar a previsão de impactos no entorno em tempo real." 
                               TextWrapping="Wrap" 
                               FontSize="12" 
                               LineHeight="18"
                               Foreground="{DynamicResource corFonte}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Grid x:Name="GridBotoesAcoes" Grid.Row="2" Margin="0, 0, 4, 4" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Button Content="Desfazer" Click="BtnDesfazer_Click" Background="{DynamicResource vermelhoSemantico}" Foreground="{DynamicResource corDestaquePrimaria}" FontWeight="Bold" BorderThickness="0" Padding="4" Cursor="Hand"/>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Button x:Name="BtnSalvarDadosRua" Content="Salvar Alterações" Click="BtnSalvarDadosRua_Click" Background="{DynamicResource corTemaPrimaria}" Foreground="{DynamicResource corDestaquePrimaria}" FontWeight="Bold" BorderThickness="0" Padding="8" Cursor="Hand"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        
        <Grid Grid.Row="4">
            
        </Grid>
    </Grid>
</Window>