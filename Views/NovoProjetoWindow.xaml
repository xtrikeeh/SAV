<Window x:Class="SAV.Views.NovoProjetoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAV"
        Title="Criar Novo Projeto de Via" 
        Height="600" 
        Width="400"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5F5F5" Padding="10" BorderThickness="0,0,0,1" BorderBrush="#DDD">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="TxtBusca" Grid.Column="0" Padding="8" FontSize="14" VerticalContentAlignment="Center"/>
                <Button Name="BtnBuscar" Content="Buscar Região" Grid.Column="1" Width="120" Margin="10,0,0,0" Padding="8" Click="BtnBuscar_Click"/>
            </Grid>
        </Border>

        <WebBrowser Name="NavegadorMapa" Grid.Row="1"/>

        <Border Grid.Row="2" Background="#F5F5F5" Padding="15" BorderThickness="0,1,0,0" BorderBrush="#DDD">
            <Grid>
                <TextBlock Name="TxtStatusArea" Text="Clique no botão 'Ativar Seleção' no mapa e desenhe o retângulo." VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#555"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="BtnCancelar" Content="Cancelar" Width="100" Padding="6" Click="BtnCancelar_Click"/>
                    <Button Name="BtnCriar" Content="Confirmar Área" Width="130" Margin="10,0,0,0" Padding="6" Background="DeepSkyBlue" FontWeight="Bold" IsEnabled="False" Click="BtnCriar_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>