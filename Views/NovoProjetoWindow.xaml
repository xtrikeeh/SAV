<Window x:Class="SAV.Views.NovoProjetoWindow"
        Icon="/Assets/sav_icon.png"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAV"
        Title="Criar Novo Projeto" 
        Height="600" 
        Width="600"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="5, 0">
            <Border Grid.Row="0">
                <Grid Margin="0,0,0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Buscar cidade: " 
                                   FontSize="16"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" 
                                 Name="TxtBusca" 
                                 Padding="8" 
                                 FontSize="14" 
                                 VerticalContentAlignment="Center"/>
                        
                        <Button Grid.Column="1"  
                                Content="Buscar" 
                                Name="BtnBuscar"
                                Width="120" 
                                Margin="10,0,0,0" 
                                Padding="5" 
                                Click="BtnBuscar_Click"
                                Background="{DynamicResource corDestaqueSecundaria}"
                                Foreground="{DynamicResource corDestaquePrimaria}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <WebBrowser Name="NavegadorMapa" Grid.Row="1"/>
        </Grid>

        <Grid Grid.Row="2" Margin="5, 0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="Nome do Arquivo de Destino (.json): " 
                           Margin="0,0,0,5"
                           FontSize="16"/>
            </Grid>

            <Grid Grid.Row="1">
                <TextBox x:Name="TxtNomeArquivo" 
                         Height="30" 
                         VerticalContentAlignment="Center" 
                         Padding="5,0"
                         Text="projeto_mapa"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBlock Name="TxtStatusArea" 
                           Text="Clique no botão 'Ativar Seleção' no mapa." 
                           VerticalAlignment="Center" 
                           FontSize="14" 
                           Foreground="{DynamicResource corFonte}"/>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Button Name="BtnCancelar" 
                            Content="Cancelar"
                            Width="100" 
                            Padding="6"
                            Background="{DynamicResource corDestaqueSecundaria}"
                            Foreground="{DynamicResource corDestaquePrimaria}"
                            Click="BtnCancelar_Click"/>
                </Grid>

                <Grid Grid.Column="1">
                    <Button Name="BtnCriar" 
                            Content="Confirmar Área" 
                            Width="130" 
                            Padding="6" 
                            Background="{DynamicResource corTemaPrimaria}" 
                            IsEnabled="False" 
                            Click="BtnCriar_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>